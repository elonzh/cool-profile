{
  "name": "cool-profile",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cards:discover": "tsx scripts/discover-cards.ts",
    "build": "pnpm cards:discover && tsdown",
    "coolp": "tsx apps/coolp/src/cli.ts",
    "check": "pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "hooks:install": "prek install",
    "sync:remotes": "git push origin main && git push github main"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0"
}
